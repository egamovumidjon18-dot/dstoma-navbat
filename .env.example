# Public URL of the deployment. Used for links, OAuth callbacks and the Telegram webhook.
APP_URL="https://your-domain.com"

# Firestore access for the server (Admin SDK).
# Firebase console → Project settings → Service accounts → Generate new private key,
# then paste the whole JSON file here on one line. Required in production; without
# it the dev server falls back to an in-memory store.
FIREBASE_SERVICE_ACCOUNT=""

# Initial superadmin login. Change the password in the panel after the first sign-in.
# Required in production: there is no default password there.
ADMIN_USER="superadmin"
ADMIN_PASS="change-me"

# Only needed when upgrading from a version that stored staff passwords encrypted:
# lets those passwords verify once before they're re-saved as hashes.
CREDENTIALS_ENCRYPTION_KEY=""

# Google Gemini API key for the AI features (X-ray analysis, patient chat, doctor bot summaries).
GEMINI_API_KEY=""

# Telegram bots: patient bot and doctor bot (from @BotFather).
TELEGRAM_BOT_TOKEN=""
VITE_TELEGRAM_BOT_TOKEN=""
DOCTOR_BOT_TOKEN=""

# Vercel signs the daily reminders cron with this token.
CRON_SECRET=""

# Optional: Google Calendar sync for doctors.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""
